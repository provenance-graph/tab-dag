{
  "manifest_version": 3,
  "name": "Tab Dag",
  "short_name": "Tab Dag",
  "description": "Tab provenance as a DAG: which tab opened which, recorded locally, with a graph and a sortable, filterable grid.",
  "version": "1.0.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "webNavigation", "storage", "unlimitedStorage", "favicon"],
  "background": { "service_worker": "bg.js", "type": "module" },
  "action": {
    "default_title": "Tab Dag",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+P" } } }
}
